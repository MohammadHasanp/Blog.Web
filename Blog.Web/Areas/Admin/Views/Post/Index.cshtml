@using Blog.CoreLayer.Dtos.Posts
@model PostFilterDto

@{
    ViewData["Title"] = "دسته بندی مقالات";
    ViewData["selected"] = "posts";
}
<section class="content-header">
    <h1>@ViewData["Title"]</h1>
    <ol class="breadcrumb">
        <li><a asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fa fa-dashboard"></i> خانه</a> </li>
        <li><a asp-area="Admin" asp-controller="Post" asp-action="Index"><i class="fa fa-dashboard"></i>مقالات</a> </li>
    </ol>
    <section class="content">
        <div class="box box-danger">
            <div class="box box-body">
                <form>
                    <div class=" box-header">
                        <button type="submit" class="btn btn-info">Filter</button>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <input asp-route-Title=" @Model.FilterParams.Title" class="form-control" type="text" placeholder="عنوان" name="Title" value="@Model.FilterParams.Title" />
                        </div>
                        <div class="col-md-6 form-group">
                            <input asp-route-CategorySlug="CategorySlug" class="form-control" type="text" placeholder="Slug category" name="CategorySlug" value="@Model.FilterParams.Slug" />
                        </div>
                        @* <input type="hidden" name="PageID" value="@Model.FilterParams.PageId"  /> *@
                    </div>
                </form>
            </div>
        </div>
        <a style="margin-bottom:2px" class="btn btn-success " asp-area="Admin" asp-controller="Post" asp-action="Add">افزودن</a>
        <div class="box box-primary">
            <div class="box-body p-0">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>عکس</th>
                            <th>عنوان</th>
                            <th>Slug</th>
                            <th>گروه</th>
                            <th>عملیات</th>
                            <th>پست ویژه</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Posts)
                        {
                            <tr>
                                <th>@item.ID</th>
                                <th>
                                    <img style="max-width:150px;max-height:150px"  src="/images/posts/@item.ImageName" />
                                </th>
                                <th>@item.Title</th>
                                <th>@item.Slug</th>
                                <th>@item.category.Title</th>
                                <th>
                                    @{
                                        ViewData["id"] = @item.ID;
                                    }
                                    <a asp-area="Admin" asp-controller="Post" asp-action="Edit" asp-route-id="@item.ID" class="btn btn-info">ویرایش</a>
                                </th>
                                <td>
                                    @if (item.IsSpecial)
                                    {
                                        <i class="fa fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-close text-danger"></i>

                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model"/>
        </div>

    </section>
</section>