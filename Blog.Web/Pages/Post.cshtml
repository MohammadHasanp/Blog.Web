@page "{slug}"
@using Blog.CoreLayer.Utilities
@model Blog.Web.Pages.PostModel
@{
    ViewData["Title"] = Model.Post.Title;
    var shortDescription = Model.Post.Description.ConvertHtmlToText();
    if (shortDescription.Length > 200)
    {
        shortDescription = shortDescription.Substring(0, 200);
    }
    var imageType = @System.IO.Path.GetExtension(Model.Post.ImageName).Replace(".", "");
    var imageUrl = @Directories.GetPostImage(Model.Post.ImageName);
}
@section MetaLink {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
}
@section MetaTags
{
    <meta property="og:type" content="article">
    <meta name="description" content="@shortDescription">
    <meta name="og:description" content="@shortDescription">
    <meta name="twitter:description" content="@shortDescription">
    <meta property="og:image" content="@imageUrl">
    <meta property="og:image:type" content="image/@imageType">
    <meta name="twitter:image" content="@imageUrl">
}
<title>@ViewData["TItle"]</title>
<div class="container">

    <ul class="breadcrumbs">
        <li class="breadcrumbs__item">
            <a asp-page="index" class="breadcrumbs__url">@Model.Post.Title</a>
        </li>
        <li class="breadcrumbs__item">
            <a asp-page="category" asp-route-CategoryTitle="@Model.Post.category.Slug" class="breadcrumbs__url">@Model.Post.category.Title</a>
        </li>
        @if (Model.Post.SubCategory != null)
        {
            <li class="breadcrumbs__item">
                <a asp-page="category" asp-route-CategoryTitle="@Model.Post.SubCategory.Slug" class="breadcrumbs__url">@Model.Post.SubCategory.Title</a>
            </li>

        }
        <li class="breadcrumbs__item breadcrumbs__item--current">
            @Model.Post.Title
        </li>
    </ul>
</div>

<div class="main-container container" id="main-container">
    <div class="row">
        <div class="col-lg-8 blog__content mb-72">
            <div class="content-box">
                <article class="entry mb-0">
                    <div class="single-post__entry-header entry__header">
                        <h1 class="single-post__entry-title">
                            @Model.Post.Title
                        </h1>

                        <div class="entry__meta-holder">
                            <ul class="entry__meta">
                                <li class="entry__meta-author">
                                    <span>نویسنده:</span>
                                    <a href="#">@Model.Post.NameUser</a>
                                </li>
                                <li class="entry__meta-date">
                                    @Model.Post.Time.ToPersianDate("ds dd ms Y")
                                </li>
                            </ul>

                            <ul class="entry__meta">
                                <li class="entry__meta-views">
                                    <i class="ui-eye"></i>
                                    <span>@Model.Post.Visit</span>
                                </li>
                                <li class="entry__meta-comments">
                                    <a href="#">
                                        <i class="ui-chat-empty"></i>@Model.comments.Count
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="entry__img-holder">
                        <img src=" @Directories.GetPostImage(Model.Post.ImageName)" alt="@Model.Post.Title" class="entry__img">
                    </div>
                    @*          <div class="entry__article-wrap">

                        <div class="entry__share">
                            <div class="sticky-col">
                                <div class="socials socials--rounded socials--large">
                                    <a class="social social-facebook" href="#" title="facebook" target="_blank" aria-label="facebook">
                                        <i class="ui-facebook"></i>
                                    </a>
                                    <a class="social social-twitter" href="#" title="twitter" target="_blank" aria-label="twitter">
                                        <i class="ui-twitter"></i>
                                    </a>
                                    <a class="social social-google-plus" href="#" title="google" target="_blank" aria-label="google">
                                        <i class="ui-google"></i>
                                    </a>
                                    <a class="social social-pinterest" href="#" title="pinterest" target="_blank" aria-label="pinterest">
                                        <i class="ui-pinterest"></i>
                                    </a>
                                </div>
                            </div>
                        </div> *@
                    <div class="entry__article">
                        <h5>توضیحات</h5>
                        @Html.Raw(Model.Post.Description)
                    </div>
                    @if (Model.RelatedPost.Any())
                    {
                        <section class="section related-posts mt-40 mb-0">
                            <div class="title-wrap title-wrap--line">
                                <h3 class="section-title">مطالب مرتبط</h3>
                            </div>
                            <div id="owl-posts-3-items" class="owl-carousel owl-theme owl-carousel--arrows-outside">
                                @foreach (var post in Model.RelatedPost)
                                {
                                    <article class="entry thumb thumb--size-1">
                                        <div class="entry__img-holder thumb__img-holder" style="background-image: url('@Directories.GetPostImage(post.ImageName)');">
                                            <div class="bottom-gradient"></div>
                                            <div class="thumb-text-holder">
                                                <h2 class="thumb-entry-title">
                                                    <a asp-page="Post" asp-route-slug="@post.Slug">@post.Title</a>
                                                </h2>
                                            </div>
                                            <a asp-page="Post" asp-route-slug="@post.Slug" class="thumb-url"></a>
                                        </div>
                                    </article>
                                }
                            </div>

                        </section>
                    }
                </article>
                <div class="entry-comments">
                    <div class="title-wrap title-wrap--line">
                        <h3 class="section-title">@Model.comments.Count دیدگاه</h3>
                    </div>
                    <main> </main>
                    <ul class="comment-list">
                        @foreach (var Comment in Model.comments)
                        {
                            <li class="comment">
                                <div class="comment-body">
                                    <div class="comment-avatar">
                                        <img alt="" src="/img/default-avatar.png">
                                    </div>
                                    <div class="comment-text">
                                        <h6 class="comment-author">@Comment.UserFullName _</h6>
                                        <div class="comment-metadata">
                                            <a href="#" class="comment-date">@Model.Post.Time.ToPersianDate("ds dd ms Y")</a>
                                        </div>
                                        <p>@Comment.Text</p>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div id="respond" class="comment-respond">
                        <div class="title-wrap">
                            <h5 class="comment-respond__title section-title">دیدگاه شما</h5>
                        </div>
                        <form class="comment-form" method="post">
                            <input type="hidden" asp-for="PostId" value="@Model.Post.ID" />
                            <p class="comment-form-comment">
                                <label for="comment">دیدگاه</label>
                                <textarea asp-for="Text" rows="5"></textarea>
                                <span asp-validation-for="Text"></span>
                            </p>
                            <p class="comment-form-submit">
                                <input type="submit" class="btn btn-lg btn-color btn-button" value="ارسال دیدگاه">
                            </p>

                        </form>
                    </div>
                }
                else
                {
                    <div style="text-align:center ;padding-bottom: 12px;font-size: inherit" class="alter alert-danger">
                        <br />
                        Pleas Go Login
                    </div>
                }

            </div>
        </div>

        <aside class="col-lg-4 sidebar sidebar--right" id="Popular_post">

        </aside>
        <div style="left: -14px;width: 1199px;" class="title-wrap title-wrap--line">
        </div>
    </div>
</div>  